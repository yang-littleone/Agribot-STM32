+        if continuous and k<len(pt) and pt[-1]-pt[k]>=1-1e-9:out['stop_time_s']=float(pt[k])
+    out['reason']=';'.join(reasons);out['baseline_y0_m_s']=y0;out['actual_target_m_s']=r1
+    return out
