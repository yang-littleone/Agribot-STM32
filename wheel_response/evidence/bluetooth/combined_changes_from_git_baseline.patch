+        e=err[tail];out.update(tail_mean_error_m_s=float(np.mean(e)),tail_mae_m_s=float(np.mean(np.abs(e))),tail_rmse_m_s=float(np.sqrt(np.mean(e**2))))
+    else:reasons.append('insufficient_complete_tail')
