+"""Export raw target/feedback, PWM, error and timing figures."""
+import pathlib
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+import numpy as np
+def write_figure(fig,path):
+    fig.savefig(path.with_suffix('.png'),dpi=180);fig.savefig(path.with_suffix('.svg'));plt.close(fig)
+def plot_trial(directory,rows,trial_id):
+    if not rows:return
+    dest=pathlib.Path(directory)/'figures';dest.mkdir(exist_ok=True)
+    t=np.array([int(r['mcu_time_unwrapped_us']) for r in rows],dtype=float);t=(t-t[0])/1e6
+    for kind in ('response','pwm','error'):
+        fig,axes=plt.subplots(2,2,figsize=(11,7),sharex=True,layout='constrained')
+        for ax,w in zip(axes.flat,'ABCD'):
+            y=np.array([float(r[f'feedback_{w}_m_s']) for r in rows]);target=np.array([float(r[f'target_{w}_m_s']) for r in rows])
+            if kind=='response':ax.step(t,target,where='post',label='Recorded target',color='#d65f28');ax.plot(t,y,label='Raw feedback',color='#256caa');unit='Wheel speed (m/s)'
+            elif kind=='pwm':ax.plot(t,[int(r[f'pwm_{w}_control']) for r in rows]);ax.axhline(16700,ls=':',color='gray');unit='PWM control value'
+            else:ax.plot(t,y-target);ax.axhline(0,color='gray',lw=.7);unit='Feedback - target (m/s)'
+            ax.set_title('Wheel '+w);ax.set_ylabel(unit);ax.set_xlabel('MCU time from first trial sample (s)');ax.grid(alpha=.2)
+            if kind=='response':ax.legend(fontsize=8)
+        fig.suptitle(trial_id+' — '+kind+' (raw samples)');write_figure(fig,dest/kind)
+    dt=np.array([int(r['cycle_dt_us']) for r in rows])/1000
+    fig,axes=plt.subplots(1,2,figsize=(11,3.5),layout='constrained');axes[0].plot(t,dt);axes[0].axhline(10,color='gray',ls=':')
+    axes[0].set(xlabel='MCU time (s)',ylabel='Control interval (ms)');axes[1].hist(dt,bins=max(5,min(30,len(np.unique(dt))*2)))
+    axes[1].set(xlabel='Control interval (ms)',ylabel='Sample count');fig.suptitle(trial_id+' — timing');write_figure(fig,dest/'timing')
+def plot_repeats(root,groups):
+    dest=pathlib.Path(root)/'summary_figures';dest.mkdir(exist_ok=True)
+    for (condition,speed),trials in groups.items():
+        fig,axes=plt.subplots(2,2,figsize=(11,7),sharex=True,layout='constrained')
+        for label,rows in trials:
+            hold=next((r for r in rows if int(r['stage'])==1),None)
+            if hold is None:continue
+            t=np.array([(int(r['mcu_time_unwrapped_us'])-int(hold['mcu_time_unwrapped_us']))/1e6 for r in rows])
+            for ax,w in zip(axes.flat,'ABCD'):
+                ax.plot(t,[float(r[f'feedback_{w}_m_s']) for r in rows],alpha=.75,lw=.9,label=label)
+                ax.set_title('Wheel '+w);ax.set(xlabel='MCU time relative to recorded step (s)',ylabel='Wheel speed (m/s)');ax.grid(alpha=.2)
+        if trials:
+            rows=trials[0][1];hold=next((r for r in rows if int(r['stage'])==1),None)
+            if hold:
+                t=[(int(r['mcu_time_unwrapped_us'])-int(hold['mcu_time_unwrapped_us']))/1e6 for r in rows]
+                for ax,w in zip(axes.flat,'ABCD'):ax.step(t,[float(r[f'target_{w}_m_s']) for r in rows],where='post',color='black',ls='--',label='Recorded target');ax.legend(fontsize=6)
+        fig.suptitle(f'{condition}, {speed:g} m/s — observed valid repeats; raw overlay')
+        write_figure(fig,dest/f'{condition}_V{int(round(speed*1000)):03d}')
diff --git a/wheel_response/tools/protocol.py b/wheel_response/tools/protocol.py
new file mode 100644
index 0000000..293b3c4
--- /dev/null
+++ b/wheel_response/tools/protocol.py
@@ -0,0 +1,73 @@
+"""WRS1 wire format. All integer and float fields are little endian."""
+import collections, struct
+MAGIC=b'WRS1'
+HEADER=struct.Struct('<4sBBH')
+TELEMETRY=struct.Struct('<IIIHBBff4f4f4h4hHHIHH')
+COMMAND=struct.Struct('<IBBHHHHH')
+ACK=struct.Struct('<IBBBBHHH')
+assert (TELEMETRY.size,COMMAND.size,ACK.size)==(84,16,14)
+OP={'HELLO':1,'ARM':2,'START':3,'STOP':4,'ABORT':5,'HEARTBEAT':6,'DISARM':7,'GET_CONFIG':8,'CLEAR_FAULT':9,'BT_UART_BAUD':10,'BT_SETUP':11}
+FIELDS=['sequence','mcu_time_us','cycle_dt_us','run_id','state','stage','cmd_v_m_s','cmd_w_rad_s']
+FIELDS += [f'{kind}_{w}_{unit}' for kind,unit in [('target','m_s'),('feedback','m_s'),('pwm','control'),('encoder','counts')] for w in 'ABCD']
+FIELDS += ['battery_mv','fault_flags','queue_drop_count','deadline_miss_count','control_exec_us']
+CSV_FIELDS=FIELDS+['segment','mcu_time_unwrapped_us','pc_receive_monotonic_ns','sequence_delta','clock_event']
+def crc16(data):
+    crc=0xffff
+    for b in data:
+        crc ^= b<<8
+        for _ in range(8): crc=((crc<<1)^0x1021 if crc&0x8000 else crc<<1)&0xffff
+    return crc
+def frame(kind,payload):
+    data=HEADER.pack(MAGIC,1,kind,len(payload))+payload
+    return data+struct.pack('<H',crc16(data))
+def command(seq,opcode,run_id=0,step=0,pre=0,hold=0,post=0):
+    return frame(16,COMMAND.pack(seq,OP[opcode],0,run_id,step,pre,hold,post))
+class Decoder:
+    def __init__(self): self.buffer=bytearray(); self.stats=collections.Counter()
+    def noise(self,n):
+        self.stats['noise_bytes']+=n
+        self.stats['noise_between_frames' if self.stats['frames'] else 'noise_before_first_frame']+=n
+    def feed(self,data):
+        self.buffer.extend(data); out=[]
+        while True:
+            pos=self.buffer.find(MAGIC)
+            if pos<0:
+                trim=max(0,len(self.buffer)-3); self.noise(trim)
+                del self.buffer[:trim]; break
+            if pos: self.noise(pos); del self.buffer[:pos]
+            if len(self.buffer)<8: break
+            _,version,kind,size=HEADER.unpack_from(self.buffer)
+            if version!=1 or kind not in (1,16,17,18) or (kind!=18 and size!={1:84,16:16,17:14}[kind]) or (kind==18 and size>1024):
+                self.stats['bad_header']+=1; del self.buffer[0]; continue
+            total=size+10
+            if len(self.buffer)<total: break
+            packet=bytes(self.buffer[:total])
+            if crc16(packet[:-2])!=struct.unpack_from('<H',packet,total-2)[0]:
+                self.stats['bad_crc']+=1; del self.buffer[0]; continue
+            del self.buffer[:total]; self.stats['frames']+=1
+            out.append((kind,packet[8:-2]))
+        return out
+class ClockTracker:
+    """Unwrap normal counters; counter rollback starts a new reboot segment.
+
+    A normal wrap is accepted only near the uint32 boundary. An ambiguous long
+    interruption starts a separate segment; no continuity claim crosses it.
+    """
+    def __init__(self): self.previous=None; self.segment=0; self.expanded=0
+    def update(self,seq,t):
+        event='normal';delta=0
+        if self.previous is None: self.expanded=t;event='first'
+        else:
+            oldseq,oldt=self.previous; delta=(seq-oldseq)&0xffffffff;dt=(t-oldt)&0xffffffff
+            seqwrap=oldseq>0xffff0000 and seq<0x10000
+            timewrap=oldt>0xf0000000 and t<0x10000000
+            reset=(seq<oldseq and not seqwrap) or (t<oldt and not timewrap) or delta>=0x80000000 or dt>=0x80000000
+            if reset: self.segment+=1;self.expanded=t;event='restart_or_ambiguous_gap';delta=0
+            elif delta==0: event='duplicate';self.expanded+=dt
+            else:
+                self.expanded+=dt
+                if timewrap: event='time_wrap'
+                elif seqwrap: event='sequence_wrap'
+        self.previous=seq,t
+        return {'segment':self.segment,'mcu_time_unwrapped_us':self.expanded,'sequence_delta':delta,'clock_event':event}
+def decode_sample(payload): return dict(zip(FIELDS,TELEMETRY.unpack(payload)))
