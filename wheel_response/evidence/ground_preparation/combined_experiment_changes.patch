+#include "WheelResponseBattery.h"
+#include "adc.h"
+#include <assert.h>
+#include <stdio.h>
+ADC_HandleTypeDef hadc1;
+static uint32_t value=1360;
+static HAL_StatusTypeDef start_status=HAL_OK,poll_status=HAL_OK;
+static unsigned starts,stops;
+HAL_StatusTypeDef HAL_ADC_Start(ADC_HandleTypeDef *h){(void)h;starts++;return start_status;}
+HAL_StatusTypeDef HAL_ADC_Stop(ADC_HandleTypeDef *h){(void)h;stops++;return HAL_OK;}
+HAL_StatusTypeDef HAL_ADC_PollForConversion(ADC_HandleTypeDef *h,uint32_t timeout){(void)h;assert(timeout==0);return poll_status;}
+uint32_t HAL_ADC_GetValue(ADC_HandleTypeDef *h){(void)h;return value;}
+int main(void){
+    assert(WRS_BatteryMv(0)==65535);WRS_BatteryPoll(0);assert(starts==1);
+    WRS_BatteryPoll(1);assert(WRS_BatteryRaw()==1360&&WRS_BatteryMv(1)==12056);
+    WRS_BatteryPoll(99);assert(starts==1);assert(WRS_BatteryMv(502)==65535);
+    value=4095;WRS_BatteryPoll(600);WRS_BatteryPoll(601);assert(WRS_BatteryMv(601)==65535);
+    poll_status=HAL_TIMEOUT;WRS_BatteryPoll(700);WRS_BatteryPoll(719);assert(stops==2);
+    WRS_BatteryPoll(720);assert(stops==3&&WRS_BatteryRaw()==65535);
+    start_status=HAL_ERROR;WRS_BatteryPoll(800);assert(WRS_BatteryMv(800)==65535);
+    start_status=HAL_OK;poll_status=HAL_OK;value=2048;WRS_BatteryPoll(900);WRS_BatteryPoll(901);
+    assert(WRS_BatteryMv(901)==18154);
+    WRS_BatteryPoll(0xfffffffeu);WRS_BatteryPoll(0xffffffffu);
+    assert(WRS_BatteryMv(5)==18154&&WRS_BatteryMv(500)==65535);
+    puts("Synthetic nonblocking ADC estimate, stale/failure/clipping and wrap checks passed.");return 0;
+}
diff --git a/wheel_response/tests/synthetic_bluetooth_test.c b/wheel_response/tests/synthetic_bluetooth_test.c
new file mode 100644
index 0000000..d283444
--- /dev/null
+++ b/wheel_response/tests/synthetic_bluetooth_test.c
@@ -0,0 +1,34 @@
+/* Synthetic UART/module model; never a vehicle measurement. */
+#include "Bluetooth.h"
+#include "usart.h"
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+UART_HandleTypeDef huart2;
+static uint32_t tick,baud=9600;
+static int connected=1,present=1;
+static const char *response="";
+int HAL_UART_Init(UART_HandleTypeDef *h){(void)h;return HAL_OK;}
+uint32_t HAL_GetTick(void){return tick++;}
+void HAL_Delay(uint32_t ms){tick+=ms;}
+void Error_Handler(void){assert(0);}
+void MX_USART2_UART_Init(void){huart2.Init.BaudRate=115200;}
+int HAL_UART_Transmit(UART_HandleTypeDef *h,uint8_t *p,uint16_t n,uint32_t timeout){
+    char cmd[40];(void)timeout;assert(n<sizeof(cmd));memcpy(cmd,p,n);cmd[n]=0;
+    assert(!strcmp(cmd,"AT+DISC\r\n")||!strcmp(cmd,"AT+VERSION\r\n")||!strcmp(cmd,"AT+BAUD8\r\n")||!strcmp(cmd,"AT+BAUD\r\n"));
+    response="";if(!present||h->Init.BaudRate!=baud)return HAL_OK;
+    if(!strcmp(cmd,"AT+DISC\r\n")){connected=0;response="+OK\r\n";}
+    else if(!connected&&!strcmp(cmd,"AT+VERSION\r\n"))response="+VERSION=JDY-33-V1.6\r\n";
+    else if(!connected&&!strcmp(cmd,"AT+BAUD8\r\n")){baud=115200;response="+OK\r\n";}
+    else if(!connected&&!strcmp(cmd,"AT+BAUD\r\n"))response="+BAUD=8\r\n";
+    return HAL_OK;
+}
+int HAL_UART_Receive(UART_HandleTypeDef *h,uint8_t *p,uint16_t n,uint32_t timeout){
+    (void)n;tick+=timeout;if(h->Init.BaudRate!=baud||!*response)return 1;*p=(uint8_t)*response++;return HAL_OK;
+}
+int main(void){
+    Bluetooth_Bootstrap();assert(Bluetooth_DetectedBaud()==9600);assert(Bluetooth_ATVerified());
+    assert(baud==115200&&huart2.Init.BaudRate==115200);
+    present=0;Bluetooth_Bootstrap();assert(!Bluetooth_ATVerified()&&Bluetooth_DetectedBaud()==0);
+    assert(huart2.Init.BaudRate==115200);puts("Synthetic JDY-33 setup and stale-verification checks passed.");return 0;
+}
